# ============================================================================
# NEXORA COIN — ENVIRONMENT CONFIGURATION TEMPLATE
# ============================================================================
# Copy this file to .env before starting the production or development server.
# NEVER commit real API keys, secrets, or production passwords to version control.
# ============================================================================

# PORT: Server listening port (default: 3000)
PORT=3000

# NODE_ENV: Application environment ('development' or 'production')
NODE_ENV="development"

# GEMINI_API_KEY: Optional. Enables Gemini AI Text-to-Speech (TTS) briefings.
# When omitted, the platform gracefully uses client-side speech synthesis.
GEMINI_API_KEY=""

# APP_URL: Canonical URL where this application is hosted.
# Used for canonical link generation, Open Graph URL tags, and sitemaps.
APP_URL="https://ais-dev-h7pgqgdjgfvcst4btfexxf-685198115935.asia-southeast1.run.app"

# ----------------------------------------------------------------------------
# RELATIONAL DATABASE CONFIGURATION (OPTIONAL / SUPABASE / POSTGRESQL)
# ----------------------------------------------------------------------------
# Public variables for client-side Supabase Auth and database operations.
# Obtain these from your Supabase Project Settings -> API.
# CRITICAL: Keep service-role secret keys strictly server-side; NEVER expose them in VITE_ variables!
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
